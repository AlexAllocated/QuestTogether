[Unit]
Description=QuestTogether VIP reward issuer
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# Replace @REPOSITORY@ when installing this user unit.
WorkingDirectory=@REPOSITORY@
EnvironmentFile=@REPOSITORY@/.local/vip-service/service.env
ExecStart=@REPOSITORY@/.local/vip-service-venv/bin/python services/vip/bot.py
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=@REPOSITORY@/.local/vip-service/data
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=default.target
